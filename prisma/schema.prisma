// Investment simulation platform — data model.
//
// IMPORTANT: This entire application is a DEMO / SIMULATION. Balances, prices,
// returns, and transactions recorded here never represent real money, real
// brokerage execution, or real market data. Fields are named plainly (not
// prefixed with "simulated") to keep the schema production-shaped, but every
// value that reaches the UI must be rendered with a DEMO/SIMULATION label —
// see lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

model Role {
  id          String @id @default(cuid())
  name        String @unique // "ADMIN" | "USER"
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)
  image        String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  portfolio     Portfolio?
  investments   UserInvestment[]
  transactions  Transaction[]
  notifications Notification[]
  paperTrades   PaperTrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Investment plans (admin-managed catalog)
// ---------------------------------------------------------------------------

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model InvestmentPlan {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String

  // Demo economics — never tied to a real yield source.
  minAmount     Decimal   @db.Decimal(14, 2)
  maxAmount     Decimal?  @db.Decimal(14, 2)
  returnRateBps Int // simulated return rate in basis points per durationDays (e.g. 850 = 8.50%)
  durationDays  Int
  riskLevel     RiskLevel @default(MEDIUM)

  isActive Boolean @default(true)

  investments UserInvestment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model UserInvestment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   InvestmentPlan @relation(fields: [planId], references: [id])

  principal    Decimal          @db.Decimal(14, 2) // demo amount committed
  currentValue Decimal          @db.Decimal(14, 2) // demo value including accrued simulated return
  status       InvestmentStatus @default(ACTIVE)

  startDate DateTime  @default(now())
  endDate   DateTime?

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([planId])
}

// ---------------------------------------------------------------------------
// Portfolio (one demo cash/holdings summary per user)
// ---------------------------------------------------------------------------

model Portfolio {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cashBalance    Decimal @db.Decimal(14, 2) @default(0) // demo available balance
  totalDeposited Decimal @db.Decimal(14, 2) @default(0)
  totalInvested  Decimal @db.Decimal(14, 2) @default(0)
  totalReturns   Decimal @db.Decimal(14, 2) @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Simulated market
// ---------------------------------------------------------------------------

enum AssetType {
  STOCK
  CRYPTO
  COMMODITY
  INDEX
  FOREX
}

model Asset {
  id     String    @id @default(cuid())
  symbol String    @unique
  name   String
  type   AssetType @default(STOCK)

  price         Decimal @db.Decimal(14, 4) // latest market/demo price
  previousPrice Decimal @db.Decimal(14, 4) // previous price for % change display

  // External market-data metadata. Null means the asset is still admin/simulation managed.
  externalSymbol String?
  externalId     String?
  currency       String   @default("USD")
  marketCap      Decimal? @db.Decimal(20, 2)
  volume24h      Decimal? @db.Decimal(20, 2)
  dataSource     String?
  lastFetchedAt  DateTime?

  isActive Boolean @default(true)

  marketEvents MarketEvent[]
  candles      PriceCandle[]
  paperTrades  PaperTrade[]
  portfolioSnapshots PortfolioSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A price tick on an asset's chart. Created only when an admin pushes the
// price up or down from the trading-control panel — there is no autonomous
// price feed; every candle traces back to a deliberate admin action.
model PriceCandle {
  id String @id @default(cuid())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  timestamp DateTime @default(now())
  open      Decimal  @db.Decimal(14, 4)
  high      Decimal  @db.Decimal(14, 4)
  low       Decimal  @db.Decimal(14, 4)
  close     Decimal  @db.Decimal(14, 4)

  createdAt DateTime @default(now())

  volume     Decimal? @db.Decimal(20, 8)
  dataSource String?

  @@index([assetId, timestamp])
  @@index([dataSource, timestamp])
}

enum PaperTradeStatus {
  OPEN
  CLOSED
}

// A user's practice trade against an asset's price chart. Opening a trade
// moves cash out of the portfolio at the current price; closing it realizes
// gain/loss back into cash at whatever the price is at close time.
model PaperTrade {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  quantity   Decimal           @db.Decimal(18, 8)
  entryPrice Decimal           @db.Decimal(14, 4)
  exitPrice  Decimal?          @db.Decimal(14, 4)
  status     PaperTradeStatus  @default(OPEN)
  pnl        Decimal?          @db.Decimal(14, 2)
  notes      String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  @@index([userId])
  @@index([assetId])
}

enum MarketEventCategory {
  RATE_CHANGE
  PRICE_MOVE
  ACCOUNT_ACTIVITY
  PLATFORM_NEWS
}

model MarketEvent {
  id          String              @id @default(cuid())
  category    MarketEventCategory
  headline    String
  description String?

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  // Always true in v1 — kept explicit so a future "real feed" source can't be
  // confused with these seeded/admin-authored demo events.
  isSimulated Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([createdAt])
}


// Daily snapshots used for the real portfolio-value history chart.
model PortfolioSnapshot {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalValue    Decimal @db.Decimal(18, 2)
  cashBalance   Decimal @db.Decimal(18, 2)
  investedValue Decimal @db.Decimal(18, 2)
  tradeValue    Decimal @db.Decimal(18, 2)
  capturedAt    DateTime @default(now())

  @@unique([userId, capturedAt])
  @@index([userId, capturedAt])
}

// ---------------------------------------------------------------------------
// Transactions & notifications
// ---------------------------------------------------------------------------

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  RETURN
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Transaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userInvestmentId String?
  userInvestment   UserInvestment? @relation(fields: [userInvestmentId], references: [id], onDelete: SetNull)

  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  amount      Decimal           @db.Decimal(14, 2)
  description String?
  reference   String? @unique // demo reference code shown to the user

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userInvestmentId])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  MARKET
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType @default(INFO)
  title   String
  message String
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Platform configuration (admin-editable, key/value)
// ---------------------------------------------------------------------------

model PlatformSetting {
  key         String  @id
  value       String
  description String?

  updatedAt DateTime @updatedAt
}
