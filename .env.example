# Neon / PostgreSQL
DATABASE_URL=
SHADOW_DATABASE_URL=

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Optional legacy Auth.js fallback
AUTH_SECRET=

# Market data providers
# Alpha Vantage is used first for stocks/forex when configured.
# Yahoo Finance is the automatic stock fallback and requires no API key.
# ExchangeRate API is the automatic USD/NGN forex fallback and requires no API key.
# CoinGecko works without a key; an optional demo key can increase limits.
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=

# Protects the production market-data cron endpoint.
CRON_SECRET=

# Only used when intentionally running the demo seed.
ALLOW_DEMO_SEED=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_USER_PASSWORD=
SEED_DEPOSIT_INSTRUCTIONS=
